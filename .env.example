VITE_STORAGE_MODE=supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Only use these locally for the one-time SQLite import. Never expose the secret key in the client build.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key
IPREP_USER_EMAIL=you@example.com
IPREP_USER_PASSWORD=choose-a-strong-password
IPREP_DB_PATH=data/interview-prep.db
